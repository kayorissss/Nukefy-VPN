<?xml version="1.0" encoding="utf-8"?>
<!--
  Nukefy keeps subscriptions, server credentials and the AES key of its vault
  on the device. Android Auto Backup used to copy all of it (plus the key, which
  lives in SharedPreferences) to Google Drive, so the encryption protected
  nothing: whoever restored the backup got a readable vault.

  Backup is disabled in the manifest; these rules are the belt to that braces
  for Android 12+, where the platform ignores the legacy flag on some OEM
  builds.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
